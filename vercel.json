{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog/gst-registration-guide", "destination": "/blog/gst-registration-documents-and-address-proof", "permanent": true },
    { "source": "/blog/gst-return-filing-guide", "destination": "/blog/gstr-1-vs-gstr-3b", "permanent": true },
    { "source": "/blog/fssai-registration-guide", "destination": "/blog/fssai-home-kitchen-cloud-kitchen", "permanent": true },
    { "source": "/blog/private-limited-company-registration-guide", "destination": "/blog/private-limited-company-registration-documents", "permanent": true },
    { "source": "/blog/llp-registration-guide", "destination": "/blog/llp-registration-partner-agreement", "permanent": true },
    {
      "source": "/auth/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin\\.registerbox\\.in"
        }
      ],
      "destination": "/control-center",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "has": [
        {
          "type": "host",
          "value": "admin\\.registerbox\\.in"
        }
      ],
      "destination": "/control-center",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin\\.registerbox\\.in"
        }
      ],
      "destination": "/control-center",
      "permanent": false
    }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:path*",
      "headers": [{ "key": "Referrer-Policy", "value": "strict-origin" }]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin\\.registerbox\\.in"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/:path*-v1.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*-v1-136.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
