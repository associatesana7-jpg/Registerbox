{
  "expo": {
    "name": "RegisterBox",
    "slug": "registerbox-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/registerbox-app-icon.png",
    "scheme": "registerbox",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/registerbox-app-icon.png",
      "bundleIdentifier": "in.registerbox.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/registerbox-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.registerbox.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/registerbox-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/registerbox-splash-logo.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "351fe150-5d6d-4aca-a9d6-02d775fc2555"
      }
    },
    "owner": "kartpinindia",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/351fe150-5d6d-4aca-a9d6-02d775fc2555"
    }
  }
}
